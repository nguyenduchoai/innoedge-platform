# Cấu hình môi trường cho InnoEdge Cloud Lite

# Tên miền trỏ tới máy chủ (để Caddy tự động xin chứng chỉ SSL)
DOMAIN=iot.example.com

# Đơn giá quy đổi xu sang VND (mặc định 1000đ/xu)
RATE_VND=1000

# Khóa bí mật kiểm tra webhook thanh toán (SePAY / PayOS)
WEBHOOK_SECRET=my_super_secure_secret_key_123
