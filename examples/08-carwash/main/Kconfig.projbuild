menu "Board — car wash"

# Tham số PHẦN CỨNG. Bo khác = sửa file này, không đụng SDK.

config GTEK_WASH_GPIO_WATER
    int "WATER (xit nuoc) relay GPIO (-1 = tat)"
    default 4

config GTEK_WASH_GPIO_FOAM
    int "FOAM (phun bot) relay GPIO (-1 = tat)"
    default 5

config GTEK_WASH_GPIO_AIR
    int "AIR (nen khi) relay GPIO (-1 = tat)"
    default 6

config GTEK_WASH_GPIO_VACUUM
    int "VACUUM (hut bui) relay GPIO (-1 = tat)"
    default 7

config GTEK_WASH_WATER_SENSOR_GPIO
    int "Cam bien co nuoc (active-low; -1 = khong lap)"
    default -1
    help
      Bom chay kho la hong bom. Co cam bien thi wash_control tu chan va bao
      canh bao no_water len cloud.

config GTEK_WASH_MAX_ACTIVATION_SEC
    int "Watchdog: mot lan bat relay toi da (giay)"
    default 600
    help
      Luoi an toan cuoi cung: relay ket ON qua nguong nay se bi cat.

config GTEK_WASH_MASTER_MARGIN_SEC
    int "Thoi gian phien du ra ngoai tong ngan sach (giay)"
    default 120

config GTEK_RELAY_GPIO
    int "Relay nha tien/credit GPIO (-1 = tat, may rua khong dung)"
    default -1

config GTEK_RELAY_PULSE_MS
    int "Do rong xung relay (ms)"
    default 80

endmenu
