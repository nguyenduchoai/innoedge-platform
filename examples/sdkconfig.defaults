# Cấu hình chung cho mọi example InnoEdge. Example nào cần khác thì đặt file
# sdkconfig.defaults riêng trong thư mục của nó (ghi đè các dòng dưới đây).

# 2 slot app 1,875MB (OTA cần chỗ ghi bản mới, rollback cần giữ bản cũ). Bảng
# TWO_OTA có sẵn chỉ cho 1MB/slot — SDK ~1,3MB không vừa. Xem partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# Bản mới treo/crash trước khi vào được cloud → bootloader tự quay bản cũ.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# TLS: OTA + WebSocket + REST đều chạy HTTPS.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# BLE provisioning dùng NimBLE (nhẹ RAM hơn Bluedroid).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# ── ĐỔI DÒNG NÀY CHO HỆ CỦA BẠN ─────────────────────────────────────────────
# Placeholder — SDK báo lỗi lúc khởi động nếu chưa đổi.
CONFIG_GTEK_SERVER_BASE_URL="https://cloud.example.com"
CONFIG_GTEK_FW_VERSION="0.1.0"

# Lớp học / bàn thử: điền WiFi ở đây là máy bỏ qua bước provisioning, lên mạng
# ngay sau khi flash. ĐỂ RỖNG khi build sản phẩm thật.
# CONFIG_GTEK_WIFI_SSID="TenWiFi"
# CONFIG_GTEK_WIFI_PASSWORD="matkhau"
