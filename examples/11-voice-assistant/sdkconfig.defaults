# Chân I2S cho bộ INMP441 (mic) + MAX98357A (amp) trên ESP32-S3 devkit.
# Bo khác = sửa file này. Đổi xong: idf.py fullclean rồi build lại.
CONFIG_IE_AUDIO_MIC_BCLK_GPIO=4
CONFIG_IE_AUDIO_MIC_WS_GPIO=5
CONFIG_IE_AUDIO_MIC_DIN_GPIO=6
CONFIG_IE_AUDIO_SPK_BCLK_GPIO=15
CONFIG_IE_AUDIO_SPK_WS_GPIO=16
CONFIG_IE_AUDIO_SPK_DOUT_GPIO=7
